#!/bin/sh
# Rule: never stage .env, key or certificate files.
# Usage: secret-files < staged-paths (one path per line)
# Config: SECRET_FILE_ALLOW  space-separated globs of paths allowed anyway (e.g. "test/fixtures/*.pem")
set -u
# shellcheck source=lib/common.sh
. "$(dirname "$0")/../../lib/common.sh"

allow=$(ql_config_get SECRET_FILE_ALLOW "")
hits=""
nl='
'

while IFS= read -r path || [ -n "$path" ]; do
  [ -n "$path" ] || continue
  base=${path##*/}
  case $base in
    .env.example | .env.sample | .env.template | .env.dist | *.env.example | *.env.sample) continue ;;
  esac
  kind=""
  case $base in
    .env | .env.* | *.env) kind="environment file" ;;
    *.key | *.pem | *.p8 | *.p12 | *.pfx | *.jks | *.keystore | *.ppk) kind="private key or keystore" ;;
    id_rsa | id_dsa | id_ecdsa | id_ed25519) kind="SSH private key" ;;
    *.crt | *.cer | *.der) kind="certificate" ;;
  esac
  [ -n "$kind" ] || continue
  if [ -n "$allow" ] && ql_glob_match "$path" "$allow"; then
    continue
  fi
  hits="${hits}${path} (${kind})${nl}"
done

[ -z "$hits" ] && exit 0

old_ifs=$IFS
IFS=$nl
# shellcheck disable=SC2086
set -- $hits
IFS=$old_ifs
ql_refuse "commit" "no secret files" \
  "these staged files are environment, key or certificate files:" \
  "unstage them (git restore --staged <file>), add them to .gitignore, and keep the values in 1Password (op:// references). For a deliberate test fixture, add its path to SECRET_FILE_ALLOW in .githooks/config." \
  "$@"
exit 1

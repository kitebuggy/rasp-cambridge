#!/bin/sh
# Rule: no credentials in staged content. Only added lines are scanned; op:// references are allowed.
# Usage: git diff --cached -U0 --no-color --no-ext-diff | secret-content
# Config: SECRET_SCAN_EXCLUDE  space-separated globs of paths not scanned
# Marker: a line containing "ql-hooks:allow-secret" is skipped (deliberate, reviewable exception).
# Matches are reported by rule, path and line only; the matched value is never printed.
set -u
# shellcheck source=lib/common.sh
. "$(dirname "$0")/../../lib/common.sh"

exclude=$(ql_config_get SECRET_SCAN_EXCLUDE "")
tmp=$(mktemp -d "${TMPDIR:-/tmp}/ql-hooks.XXXXXX") || exit 2
trap 'rm -rf "$tmp"' EXIT HUP INT TERM

# Split the diff into aligned files: meta (path<TAB>line) and content (added line text).
awk -v meta="$tmp/meta" -v content="$tmp/content" '
  /^\+\+\+ / {
    p = substr($0, 5)
    if (p == "/dev/null") { path = "" } else { sub(/^b\//, "", p); path = p }
    next
  }
  /^@@ / {
    s = $0
    sub(/^@@ -[0-9,]+ \+/, "", s)
    sub(/[ ,].*$/, "", s)
    line = s + 0
    next
  }
  /^\+/ {
    if (path != "") {
      print path "\t" line > meta
      print substr($0, 2) > content
    }
    line++
    next
  }
'

[ -s "$tmp/content" ] || exit 0

# name|case(i = insensitive, s = sensitive)|scope(all = every path, code = not test, feature or locale paths)|ERE
cat >"$tmp/rules" <<'EOF'
private key block|s|all|-----BEGIN ([A-Z0-9]+ )*PRIVATE KEY( BLOCK)?-----
AWS access key|s|all|(AKIA|ASIA)[0-9A-Z]{16}
GitHub token|s|all|(gh[pousr]_[A-Za-z0-9]{36,}|github_pat_[A-Za-z0-9_]{22,})
Slack token|s|all|xox[abposr]-[A-Za-z0-9-]{10,}
Stripe live key|s|all|(sk|rk)_live_[A-Za-z0-9]{20,}
Anthropic or OpenAI key|s|all|(sk-ant-[A-Za-z0-9_-]{20,}|sk-(proj-)?[A-Za-z0-9_-]{32,})
Google API key|s|all|AIza[0-9A-Za-z_-]{35}
Notion token|s|all|(secret|ntn)_[A-Za-z0-9]{40,}
password in URL|s|code|[A-Za-z][A-Za-z0-9+.-]*://[^/[:space:]:@'"]+:[^/[:space:]@'"]+@
credential assignment|i|code|(password|passwd|secret|api[_-]?key|access[_-]?key|auth[_-]?token|client[_-]?secret|private[_-]?key)["']?[[:space:]]*(=|:|=>)[[:space:]]*["'][^"'[:space:]]{8,}["']
EOF

hits=""
nl='
'
while IFS='|' read -r name sens scope re; do
  if [ "$sens" = i ]; then flags=-niE; else flags=-nE; fi
  for idx in $(grep "$flags" -- "$re" "$tmp/content" | cut -d: -f1); do
    text=$(sed -n "${idx}p" "$tmp/content")
    loc=$(sed -n "${idx}p" "$tmp/meta")
    path=${loc%"	"*}
    lineno=${loc##*"	"}
    case $text in
      *ql-hooks:allow-secret*) continue ;;
    esac
    if [ -n "$exclude" ] && ql_glob_match "$path" "$exclude"; then
      continue
    fi
    case $name in
      "AWS access key")
        # AWS's own documentation example key. The [E] keeps this file itself from
        # matching other credential scanners.
        case $text in *AKIAIOSFODNN7EXAMPL[E]*) continue ;; esac
        ;;
      "password in URL")
        case $text in
          *op://* | *://*:\$\{* | *://*:\<*\>@* | *@localhost* | *@127.0.0.1*) continue ;;
        esac
        ;;
      "credential assignment")
        case $text in
          *op://* | *ENV\[* | *ENV.fetch* | *\$\{* | *'<%'* | *process.env* | *os.environ* | *getenv*) continue ;;
        esac
        ;;
    esac
    if [ "$scope" = code ]; then
      case $path in
        test/* | tests/* | spec/* | features/* | */test/* | */tests/* | */spec/* | */features/* | */fixtures/* | *_test.* | *_spec.* | test_*.py) continue ;;
        config/locales/* | */locales/*) continue ;;
      esac
    fi
    hits="${hits}${path}:${lineno} (${name})${nl}"
  done
done <"$tmp/rules"

[ -z "$hits" ] && exit 0

hits=$(printf '%s' "$hits" | sort -u)
old_ifs=$IFS
IFS=$nl
# shellcheck disable=SC2086
set -- $hits
IFS=$old_ifs
ql_refuse "commit" "no credentials in content" \
  "staged lines look like credentials (values not shown):" \
  "remove the value, unstage, and reference it from 1Password instead (op://vault/item/field via op run). If a line is a deliberate non-secret, append the marker ql-hooks:allow-secret in a comment on that line, or add the path to SECRET_SCAN_EXCLUDE in .githooks/config." \
  "$@"
exit 1
